      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortează grijile săptămânii"
          }
        }
      }
    },
    "Start tonight's exercise": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Începe exercițiul de diseară"
          }
        }
      }
    },
    "This month": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna aceasta"
          }
        }
      }
    },
    "Tick today's small rhythms without opening Fallow.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifează ritmurile mici de azi fără să deschizi Fallow."
          }
        }
      }
    },
    "Today in Fallow": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Azi în Fallow"
          }
        }
      }
    },
    "Tonight": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseară"
          }
        }
      }
    },
    "Turn on “Show and tick rhythms” in Fallow, under Me.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește „Arată și bifează ritmurile” în Fallow, la Eu."
          }
        }
      }
    },
    "What tonight holds and your rhythms, without anything you wrote.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce aduce seara și ritmurile tale, fără nimic din ce ai scris."
          }
        }
      }
    },
