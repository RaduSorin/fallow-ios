    "%lld of %lld rhythms": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld din %2$lld ritmuri"
          }
        }
      }
    },
    "A free Friday": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O vineri liberă"
          }
        }
      }
    },
    "A quiet day": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O zi liniștită"
          }
        }
      }
    },
