            "value": "Vineri %1$lld/%2$lld"
          }
        }
      }
    },
    "Look back on last month": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Privește înapoi la luna trecută"
          }
        }
      }
    },
    "Mark a rhythm": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifează un ritm"
          }
        }
      }
    },
    "Monday": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Luni"
          }
        }
      }
    },
    "New month": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lună nouă"
          }
        }
      }
    },
    "Next Friday": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vinerea următoare"
          }
        }
      }
    },
    "No rhythms yet.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încă nu ai ritmuri."
          }
        }
      }
    },
    "Open Fallow once to fill this widget.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Fallow o dată ca să apară ceva aici."
          }
        }
      }
    },
    "Open the worry list": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide lista de griji"
          }
        }
      }
    },
    "Opens Fallow on a new note.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Fallow la o notă nouă."
          }
        }
      }
    },
    "Opens Fallow on the worry list: stone and clay.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Fallow la lista de griji: piatră și plastilină."
          }
        }
      }
    },
    "Opens Fallow on tonight's Friday exercise.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide Fallow la exercițiul de vineri de diseară."
          }
        }
      }
    },
    "Rhythm": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritm"
          }
        }
      }
    },
