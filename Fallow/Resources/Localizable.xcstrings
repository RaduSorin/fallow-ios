      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar conversația"
          }
        }
      }
    },
    "Only what you write here, the recent messages, your note \"What Claude knows about me\" and what you allow below. Never your journal. Nothing is kept on the server; the conversation stays encrypted on this iPhone.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar ce scrii aici, mesajele recente, notița „Ce știe Claude despre mine” și ce permiți mai jos. Niciodată jurnalul. Pe server nu rămâne nimic; conversația rămâne criptată pe acest iPhone."
          }
        }
      }
    },
