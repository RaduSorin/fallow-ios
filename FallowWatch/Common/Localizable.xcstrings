      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide o dată Fallow pe iPhone ca să se umple."
          }
        }
      }
    },
    "Open Fallow on your iPhone once, then try again.": {
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide o dată Fallow pe iPhone, apoi încearcă din nou."
